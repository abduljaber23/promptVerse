# ─────────────────────────────────────────────────────────────────────────────
# PromptVerse — environnement Docker Compose
# Copier en `.env` puis ajuster :  cp .env.example .env
# `docker compose up --build` lit automatiquement `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ==== Ports publiés sur l'hôte ==============================================
CLIENT_PORT=8080
API_PORT=3000
DB_PORT_HOST=3306
REDIS_PORT_HOST=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
REDISINSIGHT_PORT=5540

# ==== URLs publiques (telles que vues par le navigateur) ====================
CLIENT_URL=http://localhost:8080
APP_URL=http://localhost:8080

# Injecté dans le bundle front au build (ARG Vite).
# Chemin relatif -> nginx proxifie /api vers le conteneur `api` (pas de CORS).
VITE_API_URL=/api/v1
VITE_ASSETS_URL=http://localhost:9000/prompt-verse

# ==== API — exécution ======================================================
NODE_ENV=production
API_PREFIX=api
SWAGGER_ENABLED=true

# ==== Base de données (MySQL) ==============================================
# DB_HOST / DB_PORT sont forcés par docker-compose sur le réseau du conteneur
# (service `database:3306`). Valeurs ci-dessous = référence / usage hors Docker.
DB_HOST=database
DB_PORT=3306
DB_NAME=prompt_verse
DB_USER=promptverse
DB_PASSWORD=promptverse
DB_ROOT_PASSWORD=root

# ==== JWT ==================================================================
# Générer de vrais secrets :  openssl rand -hex 32
JWT_SECRET=dev_access_secret_please_change_me_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_secret_please_change_me_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ==== Redis ===============================================================
# Forcé par docker-compose sur `redis://redis:6379`.
REDIS_URL=redis://redis:6379

# ==== Stockage objet (MinIO, compatible S3) ================================
# AWS_S3_ENDPOINT est forcé par docker-compose sur `http://minio:9000`.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=promptverse
AWS_SECRET_ACCESS_KEY=promptverse_secret
AWS_S3_ENDPOINT=http://minio:9000
AWS_S3_BUCKET=prompt-verse
MINIO_ROOT_USER=promptverse
MINIO_ROOT_PASSWORD=promptverse_secret

# ==== SMTP (Mailpit en local ; fournisseur réel en prod) ===================
# SMTP_HOST / SMTP_PORT sont forcés par docker-compose sur `mailpit:1025`.
SMTP_FROM=no-reply@promptverse.com
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=promptverse
SMTP_PASSWORD=promptverse

# ==== Stripe (clés de test) ===============================================
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_PRICE_MONTHLY=price_replace_me
STRIPE_PRICE_YEARLY=price_replace_me

# ==== Optionnel ==========================================================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback
# MISTRAL_API_KEY=
