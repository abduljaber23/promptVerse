# syntax=docker/dockerfile:1

# ─────────────────────────── Dev (hot reload) ──────────────────
# Code monté en volume par docker-compose.dev.yml — pas de migrations
# automatiques ici (comme en local : `npm run migration:run` build d'abord).
# `node` (uid 1000 dans l'image) tourne npm ci pour que le volume nommé
# node_modules ait le même propriétaire que l'utilisateur hôte côté Linux.
FROM node:22-alpine

ENV NODE_ENV=development
WORKDIR /app
RUN chown node:node /app

COPY --chown=node:node package.json package-lock.json ./
USER node
RUN npm ci

COPY --chown=node:node . .

EXPOSE 3000

CMD ["npm", "run", "start:dev"]
